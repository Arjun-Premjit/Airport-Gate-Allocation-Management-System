# ============================================================================
# AGAMS — Environment Configuration (.env.example)
# ============================================================================

# 1. Aiven MySQL Connection (Preferred Production Runtime)
# Replace YOUR_USER, YOUR_PASSWORD, YOUR_HOST, YOUR_PORT with your Aiven service details.
# Standard encrypted connection (no local CA certificate file required):
DATABASE_URL=mysql+pymysql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?ssl_mode=REQUIRED

# Optional: Path to custom CA Certificate file if certificate pinning/verification is desired
# MYSQL_SSL_CA=./ca.pem

# 2. Local SQLite Development (Explicit opt-in; silent fallback is disabled)
# AGAMS_ALLOW_SQLITE_DEV=true

# 3. Security & JWT Configuration
JWT_SECRET_KEY=agams_super_secret_jwt_key_2026_vit_dbms
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
